    "parse5": "8.0.1",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vitest": ">=4.1.11 <6.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  }

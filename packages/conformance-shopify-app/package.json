{
  "name": "@aurelienbbn/conformance-shopify-app",
  "version": "0.1.0",
  "description": "Structural conformance checks for Shopify apps, packaged as a Vitest suite.",
  "keywords": [
    "app-store",
    "built-for-shopify",
    "conformance",
    "shopify",
    "shopify-app",
    "vitest"
  ],
  "homepage": "https://github.com/aurelienbobenrieth/harness/tree/main/packages/conformance-shopify-app#readme",
  "bugs": {
    "url": "https://github.com/aurelienbobenrieth/harness/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aurélien Bobenrieth",
    "url": "https://github.com/aurelienbobenrieth"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurelienbobenrieth/harness.git",
    "directory": "packages/conformance-shopify-app"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"

{
  "plugins": ["jsx-a11y"],
  "jsPlugins": ["@aurelienbbn/oxlint-plugin-shopify-app"],
  "categories": { "correctness": "off" },
  "rules": {
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "shopify-app/no-nav-emoji": "error",
    "shopify-app/no-viewport-zoom-disable": "error",
    "shopify-app/s-action-slot-contract": "error",
    "shopify-app/s-button-accessible-name": "error",
    "shopify-app/s-button-submit-no-navigation": "error",
    "shopify-app/s-clickable-accessible-name": "error",
    "shopify-app/s-form-control-label-required": "error",
    "shopify-app/s-modal-actions-use-slots": "error",
    "shopify-app/s-modal-heading-required": "error",
    "shopify-app/s-money-field-no-currency-symbol": "warn",
    "shopify-app/s-page-aside-visible": "error",
    "shopify-app/s-spinner-accessible-label": "error",
    "shopify-app/s-tooltip-no-interactive-content": "error"
  }
}

    "price": { "sel": ".Polaris-TextField", "in": "dialog" },
    "quantity": { "sel": ".input-wrapper", "nth": 1, "in": "dialog" },
    "taxable": { "sel": ".label-text", "text": "taxable", "in": "dialog" },
    "physical": { "sel": ".label-text", "text": "physical", "in": "dialog" },

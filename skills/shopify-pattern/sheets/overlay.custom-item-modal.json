{
  "entry": "overlay.custom-item-modal",
  "admin": "Orders > Create order > Add custom item",
  "path": "/draft_orders/new",
  "adminSteps": "Open Create order, click Custom item (the button sits in a hidden Polaris host: click the s-internal-button and its inner button through shadowRoot inside an expression). Modal opens; nothing typed, Add item disabled. Cancel to leave. Hover not measured. Edit order uses the same modal (not measured). Weight unit select shows kg; physical-product checkbox state not read.",
  "measured": "2026-11-16",
  "viewport": 1281,
  "root": "dialog",
  "rootWidth": 620,
  "locate": {
    "dialog": ".Polaris-Modal-Dialog__Modal",
    "header": { "sel": ".Polaris-Box", "in": "dialog" },
    "title": { "sel": "h2", "in": "dialog" },
    "close": { "sel": "button", "text": "Close", "in": "dialog" },
    "body": { "sel": ".Polaris-Modal__Body", "in": "dialog" },
    "name-label": { "sel": ".label-content", "text": "Item name", "in": "dialog" },
    "price-label": { "sel": "span", "text": "^Price$", "in": "dialog" },

{
  "entry": "overlay.product-picker-search",
  "admin": "Drafts > Create order > Product (Select products)",
  "path": "/draft_orders/new",
  "adminSteps": "Click the Product button (s-internal-button, click its inner button) in the Items card. Modal Select products opens. Footer Cancel and Add are Polaris buttons: measure through closest button of the text. Ticking the first product row ticks its 4 variants: count reads 4/500 and Add stays disabled-looking in the hidden tab (colour transition not settled): its enabled colour is not measured. Add filter popover, hover and Search by menu not measured.",
  "measured": "2026-11-16",
  "viewport": 1281,
  "root": "modal",
  "rootWidth": 620,
  "locate": {
    "modal": ".Polaris-Modal-Dialog__Modal",
    "title": { "sel": "h2", "in": "modal" },
    "close": { "sel": "button", "text": "Close", "in": "modal" },
    "search": { "sel": ".Polaris-TextField__Input", "in": "modal" },
    "search-by": { "sel": "select.Polaris-Select__Input", "in": "modal" },
    "add-filter": { "sel": "button.Polaris-Filters__AddFilter", "in": "modal" },
    "table-head": { "sel": "li[class*=\"_Root_\"]", "in": "modal" },
    "product-row": { "sel": "li[class*=\"_Root_\"]", "nth": 1, "in": "modal" },
    "product-check": { "sel": "input[type=checkbox]", "in": "product-row" },
    "variant-row": { "sel": "li[class*=\"_Root_\"]", "nth": 2, "in": "modal" },
    "variant-check": { "sel": "input[type=checkbox]", "in": "variant-row" },
    "count": { "text": "variants selected", "in": "modal" },
    "cancel": { "text": "^Cancel$", "in": "modal", "closest": "button" },
    "add": { "text": "^Add$", "in": "modal", "closest": "button" }
  },
  "parts": {

    "legacy-banner": { "sel": "div.banner", "in": "root" },
    "legacy-text": { "sel": "p.paragraph", "nth": 1, "in": "root" },
    "allow-button": { "sel": "a.button,button", "nth": -1, "in": "root" },
    "legal-line": { "sel": "p.paragraph", "nth": -1, "in": "root" }
  },
  "parts": {

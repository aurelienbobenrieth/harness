{
  "entry": "settings.legacy-feature-notice",
  "admin": "Settings > Apps > Develop apps",
  "path": "/settings/apps/development",
  "adminSteps": "Open the path. Most text sits in light DOM of s-internal-* hosts (display: contents), so outline text: search finds nothing; locate by class inside the shadow tree. The legacy paragraph is inside a yellow banner. Hover not measured.",

{
  "name": "@aurelienbbn/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Shared quality tooling for Aurelien projects.",
  "workspaces": [
    "packages/*",
    "internal/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm build && pnpm quality:check && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test:unit && pnpm catalog:check && pnpm compatibility:check && pnpm test:compatibility-policy && pnpm release:check && pnpm test:release && pnpm skills:check && pnpm test:skills && pnpm test:consumer-results && pnpm shopify:check && pnpm test:shopify-policy",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "pnpm build && pnpm test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "release:plan": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "security:check": "pnpm audit --audit-level=low",
    "quality:check": "node scripts/check-quality.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:compatibility-policy": "node --test scripts/compatibility.test.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "test:skills": "node --test scripts/skills.test.mjs",
    "test:consumer-results": "node --test scripts/consumer-results.test.mjs",
    "shopify:check": "node scripts/check-shopify.mjs",
    "shopify:sources": "node scripts/check-shopify-sources.mjs",
    "shopify:plan": "node scripts/shopify-plan.mjs",
    "test:shopify-policy": "node --test scripts/shopify-policy.test.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "test:unit": "vp test",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "catalog": "node scripts/check-catalog.mjs --write",
    "catalog:check": "node scripts/check-catalog.mjs",
    "test:package": "node scripts/test-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aurelienbbn/agentlint": "0.3.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "4.1.11",
    "@voidzero-dev/vite-plus-core": "0.3.2",
    "jscpd": "5.3.1",
    "knip": "6.37.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.9.0"
}

{
  "name": "@aurelienbbn/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Shared quality tooling for Aurelien projects.",
  "workspaces": [
    "packages/*",
    "internal/*"
  ],
  "type": "module",
  "scripts": {
    "evals:contradictions": "node evals/contradictions/run.mjs",
    "evals:triggering": "node evals/triggering/run.mjs",
    "evals:triggering:static": "node evals/triggering/run.mjs --static",
    "evals:incidents": "node evals/incidents/run.mjs",
    "test:evals": "node --test evals/lib/*.test.mjs evals/incidents/*.test.mjs",
    "build": "pnpm --recursive --if-present build",
    "check": "node scripts/check.mjs",
    "lint": "vp lint",
    "fmt": "node scripts/format.mjs",
    "fmt:check": "vp fmt --check",
    "test": "pnpm build && pnpm test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "release:plan": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "security:check": "pnpm audit --audit-level=low",
    "quality:check": "node scripts/check-quality.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:compatibility-policy": "node --test scripts/compatibility.test.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "test:skills": "node --test scripts/skills.test.mjs",
    "test:consumer-results": "node --test scripts/consumer-results.test.mjs",
    "test:check-plan": "node --test scripts/check-plan.test.mjs",
    "shopify:check": "node scripts/check-shopify.mjs",
    "shopify:sources": "node scripts/check-shopify-sources.mjs",
    "shopify:plan": "node scripts/shopify-plan.mjs",
    "test:shopify-policy": "node --test scripts/shopify-policy.test.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "test:unit": "vp test",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "catalog": "node scripts/check-catalog.mjs --write",
    "catalog:check": "node scripts/check-catalog.mjs",
    "test:package": "node scripts/test-packages.mjs",
    "evals:economy": "node evals/economy/run.mjs",
    "evals:quality": "node evals/quality/run.mjs",
    "evals:ab": "node evals/ab/run.mjs",
    "evals:deterministic": "node evals/deterministic/run.mjs",
    "test:evals:deterministic": "node --test evals/deterministic/*.test.mjs",
    "test:format": "node --test scripts/format.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aurelienbbn/agentlint": "0.3.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@voidzero-dev/vite-plus-core": "1.4.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.9.0"
}
